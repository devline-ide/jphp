["global-null",true]
["public-null",true]
["leading-slash",true]
["class-case",true]
["constant-case",false]
["protected-outside",false]
["private-outside",false]
["inside",[true,true,true,true]]
["inherited",[true,true,false,false]]
["class-pseudo",false]
["self-outside",["Error","Cannot access \"self\" when no class scope is active"]]
["parent-outside",["Error","Cannot access \"parent\" when no class scope is active"]]
["static-outside",["Error","Cannot access \"static\" when no class scope is active"]]
["parent-without-parent",["Error","Cannot access \"parent\" when no class scope is active"]]
["autoload-present",true]
["autoload-missing",false]
["autoload-throw",["RuntimeException","autoload failed"]]
["autoload-order",["DefCheck\\Loaded","DefCheck\\Absent","DefCheck\\Boom"]]
["malformed-extra",false]
["empty-member",false]
["nul-class",false]
["deferred-existence",["Error","Undefined constant \"DefCheck\\UNKNOWN_DEFINITION\""]]
